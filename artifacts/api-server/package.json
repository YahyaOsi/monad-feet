{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:privacy": "RUN_DATABASE_TESTS=1 pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/contentPrivacy.integration.test.mjs",
    "test:dm": "RUN_DATABASE_TESTS=1 pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/dmConversations.integration.test.mjs",
    "test:invites": "RUN_DATABASE_TESTS=1 pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/inviteCodes.integration.test.mjs",
    "test:community": "RUN_DATABASE_TESTS=1 pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/community.integration.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@types/ws": "^8.18.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "nanoid": "^5.1.11",
    "pino": "^9",
    "pino-http": "^10",
    "viem": "^2.48.7",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
